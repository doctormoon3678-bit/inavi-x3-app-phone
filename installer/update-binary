#!/sbin/sh
# TWRP flashable installer for the iNavi X3 -> SM-N916S port.
#
# TWRP invokes this as:  update-binary <api_version> <command_fd> <zipfile>
# Install mode   : the zip carries a system/ tree, which is copied into /system.
# Uninstall mode : the zip carries inavi/remove.txt, whose paths are deleted and
#                  then restored from the backups this installer made.
#
# Written for busybox ash (TWRP's /sbin/sh): POSIX only, no bashisms, and no
# `echo -e`, whose flag handling differs between ash, dash and bash.

OUTFD=$2
ZIPFILE=$3

ui_print() {
  printf 'ui_print %s\nui_print\n' "$1" >>/proc/self/fd/$OUTFD
}
abort() { ui_print " "; ui_print "### 중단: $1"; exit 1; }

TMPDIR=/tmp/inavix3
rm -rf $TMPDIR
mkdir -p $TMPDIR

ui_print "========================================"
ui_print " iNavi X3 -> SM-N916S 포트 설치 프로그램"
ui_print "========================================"

# ---------------------------------------------------------------- mount /system
mount /system >/dev/null 2>&1
mount -o rw,remount /system >/dev/null 2>&1
mount -o rw,remount /system /system >/dev/null 2>&1
if [ ! -f /system/build.prop ]; then
  mount /system_root >/dev/null 2>&1
  mount -o rw,remount /system_root >/dev/null 2>&1
  [ -f /system_root/system/build.prop ] && SYS=/system_root/system
fi
[ -z "$SYS" ] && SYS=/system
[ -f $SYS/build.prop ] || abort "/system 을 마운트하지 못했습니다. TWRP에서 Mount > System 을 확인하세요."

touch $SYS/.inavix3_rwtest 2>/dev/null || abort "/system 이 읽기 전용입니다. TWRP의 'Mount system partition read-only' 를 끄세요."
rm -f $SYS/.inavix3_rwtest

# /data and /cache are needed for the backup and for clearing dalvik-cache.
# TWRP does not always have them mounted when a zip is flashed.
mount /data >/dev/null 2>&1
mount /cache >/dev/null 2>&1
mount /sdcard >/dev/null 2>&1

# Pick a backup root that survives a reboot. Writing to an unmounted
# /data/media/0 would silently land on the recovery ramdisk and be lost.
BKROOT=""
for cand in /data/media/0 /data/media /sdcard /external_sd /usb-otg; do
  [ -d "$cand" ] || continue
  if mkdir -p "$cand/.inavix3_wtest" 2>/dev/null; then
    rmdir "$cand/.inavix3_wtest" 2>/dev/null
    BKROOT="$cand"
    break
  fi
done

gp() { sed -n "s/^$1=//p" $SYS/build.prop 2>/dev/null | head -n1; }

DEV=$(gp ro.product.device)
MODEL=$(gp ro.product.model)
SDK=$(gp ro.build.version.sdk)
REL=$(gp ro.build.version.release)
ABIS=$(gp ro.product.cpu.abilist)
[ -z "$ABIS" ] && ABIS=$(gp ro.product.cpu.abi)

ui_print "기기   : $MODEL ($DEV)"
ui_print "안드로이드 : $REL (SDK $SDK)"
ui_print "ABI    : $ABIS"
ui_print " "

# -------------------------------------------------------------------- unpack zip
unzip -o "$ZIPFILE" 'inavi/*' -d $TMPDIR >/dev/null 2>&1

# =============================================================== UNINSTALL MODE
if [ -f $TMPDIR/inavi/remove.txt ]; then
  ui_print ">> 제거 모드"
  n=0
  while read -r p; do
    [ -z "$p" ] && continue
    case "$p" in \#*) continue;; esac
    if [ -e "$SYS$p" ]; then
      rm -rf "$SYS$p" && n=$((n + 1))
    fi
  done <$TMPDIR/inavi/remove.txt
  ui_print "   설치 파일 $n 개 삭제"

  # restore every backup this installer made, oldest first, so a core install
  # followed by a systemui install both get rolled back
  nr=0
  for root in /data/media/0 /data/media /sdcard /external_sd /usb-otg; do
    [ -d "$root" ] || continue
    for B in "$root"/INAVI_X3_backup_*; do
      [ -d "$B/system" ] || continue
      ui_print "   원본 복원: $B"
      cp -r "$B/system/." $SYS/ 2>/dev/null && nr=$((nr + 1))
    done
  done
  if [ "$nr" = "0" ]; then
    ui_print "   복원할 백업이 없습니다 (교체된 순정 파일이 없었다면 정상)"
  else
    ui_print "   백업 $nr 개 복원 완료"
  fi
  rm -rf /data/dalvik-cache/* /cache/dalvik-cache/* >/dev/null 2>&1
  sync
  ui_print " "
  ui_print ">> 제거 완료. 재부팅하세요. 첫 부팅은 오래 걸립니다."
  umount /system >/dev/null 2>&1
  exit 0
fi

# ================================================================= INSTALL MODE
[ -f $TMPDIR/inavi/info.txt ] && while read -r l; do ui_print "$l"; done <$TMPDIR/inavi/info.txt

# --- 호환성 게이트: 여기서 막히면 기기가 아니라 패키지가 안 맞는 것입니다
[ "$SDK" = "23" ] || abort "이 패키지는 안드로이드 6.0.x (SDK 23) 전용입니다. 현재 SDK $SDK."
case "$ABIS" in
  *armeabi-v7a*) ;;
  *) abort "32비트 ARM(armeabi-v7a) ROM 전용입니다. 현재 ABI: $ABIS";;
esac

REPLACES_STOCK=0
[ -f $TMPDIR/inavi/predelete.txt ] && REPLACES_STOCK=1

# A package that removes stock apks must be able to put them somewhere safe.
if [ -z "$BKROOT" ]; then
  if [ "$REPLACES_STOCK" = "1" ]; then
    abort "백업을 저장할 곳이 없습니다. TWRP에서 Mount > Data 를 켠 뒤 다시 설치하세요."
  fi
  ui_print "경고: /data 를 쓸 수 없어 백업을 남기지 못합니다."
  ui_print "      (이 패키지는 순정 파일을 덮어쓰지 않으므로 계속 진행합니다)"
  BK=$TMPDIR/nobackup
else
  BK=$BKROOT/INAVI_X3_backup_$(date +%Y%m%d-%H%M%S 2>/dev/null || echo manual)
fi

if [ -f $TMPDIR/inavi/require_optin ]; then
  OPTIN=0
  for root in /data/media/0 /data/media /sdcard /external_sd; do
    [ -f "$root/INAVI_X3_I_UNDERSTAND" ] && OPTIN=1
  done
  if [ "$OPTIN" = "0" ]; then
    ui_print " "
    ui_print "이 패키지는 상태바/설정을 교체하는 실험용입니다."
    ui_print "부트루프 또는 상태바 소실 위험이 큽니다."
    ui_print " "
    abort "동의 파일이 없습니다. 내장메모리 최상위에 빈 파일 'INAVI_X3_I_UNDERSTAND' 를 만든 뒤 다시 설치하세요."
  fi
  ui_print "   (동의 파일 확인됨)"
fi

# --- 여유 공간 확인
NEED=$(cat $TMPDIR/inavi/size_kb 2>/dev/null)
[ -z "$NEED" ] && NEED=40000
FREE=$(df -k $SYS 2>/dev/null | tail -n1 | awk '{print $4}')
case "$FREE" in ''|*[!0-9]*) FREE="";; esac
if [ -n "$FREE" ]; then
  ui_print "/system 여유: ${FREE}KB (필요 ${NEED}KB)"
  [ "$FREE" -lt "$NEED" ] && abort "/system 공간이 부족합니다. 불필요한 순정 앱을 지운 뒤 다시 시도하세요."
fi

ui_print " "
ui_print ">> 파일 추출"
unzip -o "$ZIPFILE" 'system/*' -d $TMPDIR >/dev/null 2>&1
[ -d $TMPDIR/system ] || abort "zip 안에 system/ 트리가 없습니다."

# File lists via a temp file read line by line: `for f in $(find ...)` would
# split on whitespace inside a path.
( cd $TMPDIR/system && find . -type f ) >$TMPDIR/files.lst
( cd $TMPDIR/system && find . -type d ) >$TMPDIR/dirs.lst

# --- 백업: 덮어쓰게 되는 순정 파일만
ui_print ">> 교체 대상 백업"
mkdir -p "$BK/system"
nb=0
while read -r f; do
  rel=${f#.}
  if [ -e "$SYS$rel" ]; then
    mkdir -p "$BK/system$(dirname "$rel")"
    cp -p "$SYS$rel" "$BK/system$rel" 2>/dev/null && nb=$((nb + 1))
  fi
done <$TMPDIR/files.lst

# --- 같은 패키지명을 가진 순정 앱 디렉터리를 비켜두어야 하는 경우
#     (예: X3 SystemUI/Settings 로 교체) — 백업한 뒤 삭제한다
if [ "$REPLACES_STOCK" = "1" ]; then
  while read -r p; do
    [ -z "$p" ] && continue
    case "$p" in \#*) continue;; esac
    for t in $SYS$p; do
      [ -e "$t" ] || continue
      rel=${t#$SYS}
      mkdir -p "$BK/system$(dirname "$rel")"
      cp -rp "$t" "$BK/system$(dirname "$rel")/" 2>/dev/null && nb=$((nb + 1))
      rm -rf "$t"
      ui_print "   순정 제거: $rel"
    done
  done <$TMPDIR/inavi/predelete.txt
fi
ui_print "   백업한 순정 항목 $nb 개 -> $BK"

# --- 설치
ui_print ">> /system 에 설치"
cp -r $TMPDIR/system/. $SYS/ || abort "복사 실패"

# --- 소유자 / 권한 / SELinux 라벨
ui_print ">> 권한 및 SELinux 라벨 적용"
CHCON=""
for c in /sbin/chcon /system/bin/chcon chcon; do
  $c u:object_r:system_file:s0 $SYS/build.prop >/dev/null 2>&1 && CHCON=$c && break
done
while read -r f; do
  rel=${f#.}
  chown 0:0 "$SYS$rel" 2>/dev/null
  chmod 0644 "$SYS$rel" 2>/dev/null
  [ -n "$CHCON" ] && $CHCON u:object_r:system_file:s0 "$SYS$rel" 2>/dev/null
done <$TMPDIR/files.lst
while read -r d; do
  rel=${d#.}
  [ -z "$rel" ] && continue
  chown 0:0 "$SYS$rel" 2>/dev/null
  chmod 0755 "$SYS$rel" 2>/dev/null
  [ -n "$CHCON" ] && $CHCON u:object_r:system_file:s0 "$SYS$rel" 2>/dev/null
done <$TMPDIR/dirs.lst
[ -z "$CHCON" ] && ui_print "   (chcon 없음 - 라벨은 부팅 시 재설정에 의존합니다)"

# --- 복원 스크립트를 백업 폴더에 남긴다
if [ -n "$BKROOT" ]; then
  cat >"$BK/restore.sh" <<'EOS'
#!/sbin/sh
# TWRP 터미널에서:  sh <이 파일의 경로>
D=$(dirname "$0")
mount /system 2>/dev/null; mount -o rw,remount /system 2>/dev/null
cp -r "$D/system/." /system/ && echo "원본 복원 완료"
EOS
  chmod 0755 "$BK/restore.sh" 2>/dev/null
fi

# --- dex 캐시를 비워 첫 부팅에 새 apk 가 다시 컴파일되게 한다
ui_print ">> dalvik 캐시 정리"
rm -rf /data/dalvik-cache/* /cache/dalvik-cache/* >/dev/null 2>&1

sync
umount /system >/dev/null 2>&1

ui_print " "
ui_print "========================================"
ui_print " 설치 완료"
if [ -n "$BKROOT" ]; then
  ui_print " 백업: $BK"
else
  ui_print " 백업: 없음 (덮어쓴 순정 파일이 없습니다)"
fi
ui_print " 되돌리기: 제거(uninstall) zip 플래시"
ui_print "========================================"
ui_print " 첫 부팅은 dex2oat 때문에 5~15분 걸립니다."
ui_print " 홈 버튼을 누르면 런처 선택창이 나옵니다."
exit 0
